    "S": [
      {
        "name": "邪眼寄主",
        "img": "/resource/89dc94790efebe9eadc32b17edb18ec2.png",
        "type": "时装",
        "description": "在背叛的那一刻，他就知道复苏的邪眼将令自己坠入深渊，令整个城市都陷入疯狂——但都好过一切在冰封中寂静无声。\n深渊珍宝限定稀世时装",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "蒸汽少年",
        "img": "/resource/9adafbcd4e0287fb81e8697b306b0299.png",
        "type": "时装",
        "description": "邪眼能重新点燃高塔核心拯救这个冰封的城市，但更可能把一切推入另一个未知深渊——面对真相之后的抉择，少年将如何自处?\n深渊珍宝限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "时之砂",
        "img": "/resource/7ca94c4d9fb0b0cb0731e976bba5683c.png",
        "type": "时装",
        "description": "高塔封冻，能源枯竭，她预见城市终将被严寒吞噬，但无法预见那个少年的最终选择——即便时间能短暂倒流，命运却无从掌握。\n深渊珍宝限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "光学镜面",
        "img": "/resource/395674ce07b085961fada0c9b7af556c.png",
        "type": "时装",
        "description": "作为团长，他恪守着冒险团世代封存邪眼的使命，只敢在光与影的幻象中满足占有欲——直到那场背叛将他彻底击垮。\n深渊珍宝限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "音波",
        "img": "/resource/47a9e293f41a20a6d7d696c1ebbb44dc.png",
        "type": "时装",
        "description": "她追寻着来自深渊的呼唤，终于在熔炉高塔定位到了叛徒的位置，一切都将在那里有所了断。\n深渊珍宝限定奇珍时装",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "铁帽团长",
        "img": "/resource/d8c7a2a8d95f8af187473b74d081aca4.png",
        "type": "时装",
        "description": "走投无路的人组成了铁帽团，他们将蒸汽之都视为最后的居所。无论用何种极端的方式，他们都会在这里活下去。\n深渊珍宝限定独特时装",
        "repeat": 200
      },
      {
        "name": "铁帽警长",
        "img": "/resource/6993d4e73f2b4df48f3e5b6dcbff23d1.png",
        "type": "时装",
        "description": "蒸汽之都是所有法外之人的庇护所，这里奉行着海盗般强者为尊的生存法则，但并不妨碍有人以义警自称。\n深渊珍宝限定独特时装",
        "repeat": 200
      },
      {
        "name": "铁帽黑手",
        "img": "/resource/a2e77605837dfcdcb620a37380ffa34b.png",
        "type": "时装",
        "description": "他靠着叛徒的消息偷到了冒险团的宝箱，但那个会咬人的玩意儿让他吃足了苦头。\n深渊珍宝限定独特时装",
        "repeat": 200
      },
      {
        "name": "化学剂师",
        "img": "/resource/53bd704847835fa2f3acff95f1d028ad.png",
        "type": "时装",
        "description": "严寒阻滞了邪眼的复苏，但无法阻止它对人心的影响，她获得了灵感，激发了潜能，陷入了疯狂\n深渊珍宝限定独特时装",
        "repeat": 200
      },
      {
        "name": "银行家",
        "img": "/resource/16dae0742ad74732748b44fb9b23c463.png",
        "type": "时装",
        "description": "蒸汽之都的通货不是钱币，而是熔炉高塔从地热攫取的每一份热源。高塔的核心熄灭不久后，他所保管的塔顶钥匙亦不知所踪。\n深渊珍宝限定独特时装",
        "repeat": 200
