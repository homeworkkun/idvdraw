    "S": [
      {
        "name": "蝰",
        "img": "/resource/cce66fcc018f1730130a159cf5e118b0.png",
        "type": "时装",
        "description": "该结束了，无论是这趟旅程，还是缠绕我整个人生的寒冷，我的引领者不惜代价让我远离这里，但“她”却让我不得不做出抉择一-践行誓约或者拨正命运。\n（【限定】时装，仅能在第十一赛季精华2中获得）",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "羽蛇",
        "img": "/resource/cef40ca70f7fd0a1cac0ec46174d3a7e.png",
        "type": "时装",
        "description": "我的孩子，也许在你的祖辈们许下愿望的那一刻，你们就该明白，神明的青睐，容不下一丝欺瞒。",
        "repeat": 1000
      },
      {
        "name": "“向导”",
        "img": "/resource/274b6c9f0055a5577410e23b40c27a0c.png",
        "type": "时装",
        "description": "如果说是那个被我视作“母亲”的人，将我推入那不该属于我的命运。那又是谁，将她的“命运”，导向这被诅咒的密林。",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "蜂鸟",
        "img": "/resource/1acf12c7ffa7d27746de60df889a8c61.png",
        "type": "时装",
        "description": "进入密林第二天，先行探查的我，找到了队长留下的线索，这本该是一个好的开始，但我却开始不安，因为我发现从那一刻起，暗处就一直有什么东西在伺机而动，也许是伏击我们的猎手，也许是我们此行的猎物。",
        "repeat": 200
      },
      {
        "name": "花蛛",
        "img": "/resource/515bf515494068c1c8757e4f8f69eb1e.png",
        "type": "时装",
        "description": "外来者，如果你不被这密林的主人认同，那么等待你的就不会是神庙中的秘宝，而是我捕食的毒网。",
        "repeat": 200
      },
      {
        "name": "鸢尾",
        "img": "/resource/a38ea01e3ed019b609fc3e46894784fd.png",
        "type": "时装",
        "description": "尽管那次沙漠探险的结果并不十分成功，但至少证明了那本笔记的价值，我用更高的报酬，找来了更好的帮手，进入密林的第一天，他们向我展现了什么叫物超所值。",
        "repeat": 200
      },
      {
        "name": "攀蜥",
        "img": "/resource/63946a01712e171a7d0e4e40c63d1a7b.png",
        "type": "时装",
        "description": "嘶~我很少遇见比我更适合密林的寻宝猎人，毕竟，我稍稍有些“与众不同”。不过当我在第三天见到那个耷拉着半只眼的家伙时，我不得不承认蛇是比蜥蜴更危险的动物。",
        "repeat": 200
      },
      {
        "name": "刺歌雀",
        "img": "/resource/a4957b1a7c79484330ba88cd57478282.png",
        "type": "时装",
        "description": "一望无际的密林，湿热的天气，已经让我们昏昏入睡。然而“4”，显然是我的幸运数字，我们第一次见到了这里的原住民，即便他们难以交流到让人头疼。但我原谅他们，毕竟如果队长所言非虚，那这会是我享受美妙退休生活前，最后一次寻宝之旅。",
        "repeat": 200
      },
      {
        "name": "燕尾蝶",
        "img": "/resource/41d786f6e508d554f44a98c785cf60ed.png",
        "type": "时装",
        "description": "第五天，似乎总不是什么好日子，尤其对我们而言，刚踏入神庙我们就跟队长走散了。我们感受到了“她”对外来者的排斥，除了队长以外，那奇怪的神明似乎觉得，他本该属于这里，即便在此之前，他从未踏上过这片土地。",
        "repeat": 200
      },
