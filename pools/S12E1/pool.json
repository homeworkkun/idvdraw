    "S": [
      {
        "name": "炼狱奏曲",
        "img": "/resource/dab697c64851f10d0829e354ec47d84d.png",
        "type": "时装",
        "description": "无人能抵抗这位地狱来客在乐理中施加的意志。但奏者只在乎高雅格调的纯净，不为靡靡之音所谄媚。当听闻有异类为追求乐理而叛逃人间时，他才终于有了一展实力的兴致。\n（【限定】时装，仅能在第十二赛季精华1中获得）",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "琴键",
        "img": "/resource/c4fdb9ca387eea730ceb662d29dc7252.png",
        "type": "时装",
        "description": "为乐痴狂的异类，因不堪忍受地狱之音的严苛规矩和贵贱之别，而在人间自我放逐。在路过到一间古怪酒吧时，他被久违的乡音吸引，却没料想自己步入了一个需要赌上信念的陷阱。",
        "repeat": 1000
      },
      {
        "name": "骨笛",
        "img": "/resource/44a48a61e138458c6836c10476349997.png",
        "type": "时装",
        "description": "他在狩猎逃叛的恶魔时，嵌入身上的笛子会不断冒出蒸汽，喷响骇人的笛声－－那是战利品们留存在世的唯一哀嚎。而他的下一个目标，就是在人间自甘堕落的家伙。",
        "repeat": 1000
      }
    ],
