    "S": [
      {
        "name": "永夜极光",
        "img": "/resource/f9d56c3efb78d78a5ddf3e63c65ad097.png",
        "type": "时装",
        "description": "掌控者之名的真意，和其真面目一样鲜有人知：她希望成为这座永夜之都的极光一—如极地遇难者在失去体温前，最后聊以慰藉的美丽。\n深渊珍宝Ⅴ限定稀世时装",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "霓虹先锋",
        "img": "/resource/2da957ac9a2d52510e658491b4114855.png",
        "type": "时装",
        "description": "在他拆掉霓虹灯，以最浮夸的方式反抗所有诱惑时，他意外发现霓虹灯管中潜伏着以颜色为载体的诡异生命体。\n深渊珍宝Ⅴ限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "花边新闻",
        "img": "/resource/8b578141783a7e55bf7f8be666a9ceb9.png",
        "type": "时装",
        "description": "以收集花边新闻为由，她一直嗅探着大都会浮华背后的秘密和丑闻：只有她自制的测谎仪和犀利提问，才能刺激到人们早已麻木的神经。\n深渊珍宝Ⅴ限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "海盗电台",
        "img": "/resource/8dac9c80486080fc628ddda69c86aeff.png",
        "type": "时装",
        "description": "在无人问津的港口，他勉力维持着无处启航的“海盗电台”，抢占广播频段的每个间隙以警醒众人：整座城市不过是一处浮华的孤岛。\n深渊珍宝Ⅴ限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "放映厅",
        "img": "/resource/5c67211a07afbc5bc7160bf50f28af0a.png",
        "type": "时装",
        "description": "大都会的院线里没有痛苦悲伤，警醒批判。但在他瞒天过海地剪辑下，空洞的影片里终于出现了一些经典镜头——哪怕只是一闪而过。\n深渊珍宝Ⅴ限定奇珍时装",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "军乐队",
        "img": "/resource/9ee0c08086252c1f5522bd022faf16e0.png",
        "type": "时装",
        "description": "作为头牌明星的公关负责人，他认为媒体大战中的所有报导、广告、舆论都是武器，应如军乐中的每段旋律编排一样精准、有效。\n深渊珍宝Ⅴ限定独特时装",
        "repeat": 200
      },
      {
        "name": "化妆师",
        "img": "/resource/888f050cdfa477dcb01d3af98ccc7f95.png",
        "type": "时装",
        "description": "当大都会的迷醉者们终于无法忽视自己身体的异变时，只会想到为了遮丑而求助于化妆师——这里没有医院，也不需要医院。\n深渊珍宝Ⅴ限定独特时装",
        "repeat": 200
      },
      {
        "name": "粉刷匠",
        "img": "/resource/b50f6d2639bc62f1dc0b0a901f19c330.png",
        "type": "时装",
        "description": "大都会的欢享之夜永无日出。他只能将自己绘画天赋拘束在一块块广告墙上，寄生在遍布整座城市的霓虹灯牌之下。\n深渊珍宝Ⅴ限定独特时装",
        "repeat": 200
      },
      {
        "name": "治安官",
        "img": "/resource/4f2274bba08b72b060b50750bf0991b0.png",
        "type": "时装",
        "description": "头牌明星作为掌控者，并不需要调用治安官的武力来铲除异己。在没有硝烟的媒体大战中，真正的力量是舆论和影响力。\n深渊珍宝Ⅴ限定独特时装",
        "repeat": 200
      },
      {
        "name": "交通旗",
        "img": "/resource/d0c2262cda6dd2e8090f0683563a6ca7.png",
        "type": "时装",
        "description": "大都会少有外界的娱乐和新闻，但关于一个赛车拉力赛的消息却总有专人定期更新。这不是掌控者所能摆布的，而是源于更幕后的势力。\n深渊珍宝Ⅴ限定独特时装",
        "repeat": 200
      },
