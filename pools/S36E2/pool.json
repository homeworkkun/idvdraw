  "items": {
    "S": [
      {
        "name": "不息载械",
        "img": "/resource/72599ddc0dddce17f42dbc10fe6202db.png",
        "type": "时装",
        "description": "唯有在扭曲中走向难测的变化，才是此处永恒不变的定则。她并不比荒原上的任何事物更加强韧，但这并不意味着落入被摧毁和耗竭的境地：能使自身延续于环境的一切策略，都有其存在的意义。 \n深渊珍宝Ⅷ限定稀世时装 ",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "异动指针 ",
        "img": "/resource/5aa450805d2cd7175642227c16b1d0d5.png",
        "type": "时装",
        "description": "“人”与“物”的边界在这片荒原逐渐被抹除，而“向导”在缄默中指引着这支队伍行进。无论如何，她在一次次致命的危境中带来奇迹般的转机，从而被信赖——即使她对荒原认知的来源，仍是值得探究的谜团。 \n深渊珍宝Ⅷ限定奇珍时装 ",
        "repeat": 1000
      },
      {
        "name": "警戒哨台",
        "img": "/resource/0794bd3aaf7937bca0847480b6dded9e.png",
        "type": "时装",
        "description": "胆小的“哨兵”踏上了这趟充满危机的旅途，好在小队成为了他新的伙伴，能使他在生命的残骸中重新燃起营火。他为所有人排除一切可能的威胁——无论是能以常理被揣度的，亦或是远超想象之外的。 \n深渊珍宝Ⅷ限定奇珍时装 ",
        "repeat": 1000
      },
      {
        "name": "采集速巡",
        "img": "/resource/88b31c610550d16547fec0b3abebc56b.png",
        "type": "时装",
        "description": "没有人比“采集人”更了解，死亡与美丽是如何在这片无界之地并存的。被侵蚀的身躯正穿梭于此地，风和水流穿过她躯体的缝隙：她感到自己轻得不可思议，而在真正的自由面前，没有什么代价是不值得的。  \n深渊珍宝Ⅷ限定奇珍时装 ",
        "repeat": 1000
      },
      {
        "name": "义体再构",
        "img": "/resource/0567acc0541ec9865d152a4e51125ae8.png",
        "type": "时装",
        "description": "“义体师”曾为修复脆弱的生命而步入禁忌，彼时的他未曾料到，自己还将无数次把诅咒般的机关并入更多的躯体。而最残酷的，莫过于他已面目全非，却仍受制于人类的极限，无法往前再迈进一步。 \n深渊珍宝Ⅷ限定奇珍时装 ",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "木卫兵领队",
        "img": "/resource/9953a29196d18077cd2b75e00136aeb9.png",
        "type": "时装",
        "description": "它所带领的这支队伍以巨细靡遗的工艺、栩栩如生的外观闻名，由“特洛伊木马”的工匠制造而成。这些“木质的卫兵”正因不知道自己过去是谁，所以从不停止脚步。\n深渊珍宝Ⅷ限定独特时装  ",
        "repeat": 200
      },
      {
        "name": "异体同生",
        "img": "/resource/dc2f8d143d9eb5d7ee75d8de9b0e8fb1.png",
        "type": "时装",
        "description": "他们由木质的血肉相连，两个灵魂共享一具身躯，或许有一天，“侵蚀”还是会使仅剩的一颗心脏变得如朽木般枯硬，继而停止跳动。但在那之前，他们仍有时间共同呼吸。\n深渊珍宝Ⅷ限定独特时装 ",
        "repeat": 200
      },
      {
        "name": "塔顶人",
        "img": "/resource/d07f24d57a71fe072f489419c9efeb01.png",
        "type": "时装",
        "description": "只有为数不多的人知道，荒原上定居点的“形式”固有其背后的意义——“高塔”使它永远被抑制在文明的童年岁月，由此延伸出另一种截然不同的道路，以防再度惊动沉睡于地底的灾厄。 \n深渊珍宝Ⅷ限定独特时装 ",
        "repeat": 200
      },
      {
        "name": "未燃书页",
        "img": "/resource/8a16b3ad12f4b0835729346c825eaca9.png",
        "type": "时装",
        "description": "他曾经因优良的纪律性，秘密承担着一份销毁违禁品的工作，然而自从好奇心驱使着他翻开那些“秘密”之后，就一发不可收拾。他第一次对自己置身的这个“世界”，开始产生隐约的疑虑。 \n深渊珍宝Ⅷ限定独特时装 ",
        "repeat": 200
      },
      {
        "name": "被抹除者",
        "img": "/resource/49c459011947ae0534ccfaa6dc003d86.png",
        "type": "时装",
        "description": "许多人还记得这位大人物因意外故去的消息。然而在许久之后，有目击者声称见到这位已故之人出现在了荒原的角落——但早已破衣烂衫，身体也大改模样。 \n深渊珍宝Ⅷ限定独特时装 ",
        "repeat": 200
      },
