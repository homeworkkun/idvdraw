    "S": [
      {
        "name": "初拥",
        "img": "/resource/c57a1579d0c3e8d4d4859d36f2e1d40f.png",
        "type": "时装",
        "description": "血族的渊源已不可考，而初拥撰写魔典的秘辛一直在族群中流传。古堡盛宴之后，血族盟约随着魔典失衡而崩塌。但原主现身后，书写命运的资格将不再旁落。\n（【限定】时装，仅能在第十赛季精华1中获得）",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "暮剑",
        "img": "/resource/73ec61f7abd42bd5f2e0ea9b13dbfba5.png",
        "type": "时装",
        "description": "为了掠取魔典之力而在暗中行动，并通过镜中消息掌控了古堡残局。但初拥意外现身时，他只能眼看到手之物旁落。然而，下一个要猎取的对象，他绝不放手。",
        "repeat": 1000
      },
      {
        "name": "逆刃之鞭",
        "img": "/resource/bedea1b8d5db2447943e89f76cc23a6d.png",
        "type": "时装",
        "description": "曾在血族中遭到背叛并被驱逐的异类。他以摧毁血族盟约的压迫为信念，相信必要付出代价才能获得救赎。",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "失却之人",
        "img": "/resource/7ff75f198ec6667b34e4c7df7da83220.png",
        "type": "时装",
        "description": "厌倦无尽争斗的伯爵，在放下一切后终于找到了自己的归宿。但眼看族群与教会愈演愈烈的冲突，他是否还会继续带着伪装的面孔置身事外?",
        "repeat": 200
      },
      {
        "name": "迷途枪手",
        "img": "/resource/55515a17ffa9cfb1336730c9bb371cfe.png",
        "type": "时装",
        "description": "盛宴过后，一度迷茫的她放走了猎人，独自回到教堂受罚。但内心的挣扎驱使她再返古堡，见证三方势力最后的终局。",
        "repeat": 200
      },
      {
        "name": "改造者",
        "img": "/resource/cc56bd6084d00cfd42303cdb9cdc6a6d.png",
        "type": "时装",
        "description": "躲藏在教会深处的神秘改造者，是否代表着血族真正源头所在?她抛弃纯净血脉，不惜将自己进行异类的改造，尝试将血族的力量扩散到其他生命个体中。",
        "repeat": 200
      },
      {
        "name": "归化者",
        "img": "/resource/e436745fc8c9362a5e2f2ab4393bdeab.png",
        "type": "时装",
        "description": "她最终成为了被魔典所归化的一员，但并没有迷失自我，反而站在立场的另一面，深入教堂不为人知的密门，探寻双方的渊源。",
        "repeat": 200
      },
      {
