      }
    ],
    "A": [
      {
        "name": "助燃剂",
        "img": "/resource/d66a010dfa82fd7d98c31ceaf70d9a5f.png",
        "type": "时装",
        "description": "隶属能源企业，却是医疗企业的秘密实验员。她明白发动机可用助燃剂，身体可用强化剂，但合格的精神只能通过惨烈的比赛来筛选。\n深渊珍宝Ⅳ限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "反光镜",
        "img": "/resource/64a7ff6d643944519ad8c06a4d13ce50.png",
        "type": "时装",
        "description": "隶属医疗企业。她依靠镜面反射在花苑长廊中找寻隐藏捷径。但她早就察觉到，自己也不过是企业试探失控怪物的一块踏板而已。\n深渊珍宝Ⅳ限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "气胎",
        "img": "/resource/414145260fb896f1ad1be0ec08b4a48c.png",
        "type": "时装",
        "description": "隶属运输企业。他为冻港赛道做足了准备：无论付出什么代价，他都想揭开这条赛道尽头所隐藏的秘密，结束这个阴谋角力的试验场。\n深渊珍宝Ⅳ限定奇珍时装",
        "repeat": 1000
      },
      {
        "name": "公路骑士",
        "img": "/resource/1ff46658ae24dda292f21d3a7fbf5bdb.png",
        "type": "时装",
        "description": "曾隶属运输企业。在赛道上，他执着地扮演着时代里最后的骑士，想以车手最纯粹的方式完成比赛——即便经受了无数痛楚和失败。\n深渊珍宝Ⅳ限定奇珍时装",
        "repeat": 1000
      }
    ],
    "B": [
      {
