    "S": [
      {
        "name": "灾厄之主",
        "img": "/resource/1b64259929451affcb21911ad8e2fdc6.png",
        "type": "时装",
        "description": "沉睡于深渊之中的巨物，渺小的生命们视它为灾厄的源头或启示的开端。但最终，人们只能在它身上看到自己，对于人类，它也只能成为一面丈量欲望的镜子。 \n深渊珍宝Ⅶ限定稀世时装 ",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "稀缺病案",
        "img": "/resource/32958d5274b1598fa346d56515c2d796.png",
        "type": "时装",
        "description": "被菌丝日渐侵蚀的男人，终于在废墟中等来了自己的爱人。当木头逐渐被替换，这艘船还会是之前的船吗？他破碎的语句和被作为武器的寄生菌丝们，兴许能给出答案。 \n深渊珍宝Ⅶ限定奇珍时装 ",
        "repeat": 1000
      },
      {
        "name": "末世搜救",
        "img": "/resource/42aca5b799c5631707cab103a5be454f.png",
        "type": "时装",
        "description": "避难所禁止任何感染者进入——前搜救队长曾严格遵循着这条规则。但与爱人重逢后，她发现了一些新的可能性。而更多的答案，需要在前往深渊的途中找寻。 \n深渊珍宝Ⅶ限定奇珍时装 ",
        "repeat": 1000
      },
      {
        "name": "先驱探索",
        "img": "/resource/6d96896ac5484479ecd5da88580e5411.png",
        "type": "时装",
        "description": "比起一成不变的生活腐烂锈蚀，他更愿在避难所外冒险。小队已经集结，他们能否捕捉到那些幻境中一闪而过的灵感？ \n深渊珍宝Ⅶ限定奇珍时装 ",
        "repeat": 1000
      },
      {
        "name": "菌丝研究",
        "img": "/resource/afa12e0740fcedb2b6bd94a2b24ad0b5.png",
        "type": "时装",
        "description": "她研究如何驾驭菌丝，试图让它们成为为人类所用的材料或能源。但这些被她培育的小东西，总打着和她相似的主意。 \n深渊珍宝Ⅶ限定奇珍时装 ",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "机构齿轮",
        "img": "/resource/4e673299c78bdd1d7987a74854a3f2c8.png",
        "type": "时装",
        "description": "和绝大多数人一样平凡的家伙，在危机四伏的时代，如齿轮般规律地运转才能维持更稳定的生活。 \n深渊珍宝Ⅶ限定独特时装 ",
        "repeat": 200
      },
      {
        "name": "末世信仰",
        "img": "/resource/74021cd0dcab70cfdbc93b413bb0c3ab.png",
        "type": "时装",
        "description": "她已无从分辨光怪陆离的梦境是启示还是蛊惑，但在绝望之际，人人都需要一个来支撑理智的谎言。 \n深渊珍宝Ⅶ限定独特时装 ",
        "repeat": 200
      },
      {
        "name": "菌丝专著",
        "img": "/resource/0b5390e721cdee3931df1984847c6e0e.png",
        "type": "时装",
        "description": "她仍坚信能用人类所了解的知识来诠释它，直到它终究被人类征服，或征服所有人类。即使，越来越多的研究者开始对自己所熟知的一切产生动摇、怀疑。 \n深渊珍宝Ⅶ限定独特时装 ",
        "repeat": 200
      },
      {
        "name": "失败的探索",
        "img": "/resource/b3624978ed320814a5ef9bff6486e638.png",
        "type": "时装",
        "description": "人们总是在寻找他们认知中的图像，某个星球，某种文明……然而当苦苦寻觅的重点超越认知时，他们宁愿相信那是荒谬的想象。 \n深渊珍宝Ⅶ限定独特时装 ",
        "repeat": 200
      },
      {
