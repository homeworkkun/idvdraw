  "items": {
    "S": [
      {
        "name": "“夜魔”",
        "img": "/resource/c11d1d08d1901bdbed86d93b68e169d8.png",
        "type": "时装",
        "description": "父亲把那个娃娃交给那个女孩后，跟我说:“你并不需要两个玩具，贪婪是让人堕落的罪恶”。他说的没错，不过，这个庸碌之人，并无法知悉，我更想要哪一个。\n( 【限定】时装，仅第十八赛季精华1中可获得。)",
        "repeat": 2000
      }
    ],
    "A": [
      {
        "name": "“王子”",
        "img": "/resource/e1c381829044976964732056d68dc72a.png",
        "type": "时装",
        "description": "你见过那个王子么?他的眼睛，像最美丽的蓝宝石，温柔又清澈；他的头脑，像最精密的仪器，聪明又伶俐；他的心，像不含一丝杂质的金子，璀璨又冷硬。",
        "repeat": 1000
      },
      {
        "name": "祈雨之女",
        "img": "/resource/02eadd831bbc90a8d4a43dd11e8602cc.png",
        "type": "时装",
        "description": "当神女在熊熊燃烧的大殿里，孑然一人，跳起最后的祈雨之舞时，她的心中，是爱更多，还是恨更多？",
        "repeat": 1000
      }
    ],
    "B": [
      {
        "name": "“悲”",
        "img": "/resource/36ef36b9c55017156ffcc344bc66d099.png",
        "type": "时装",
        "description": "有人说，那对夫妇死于那个孩子的怨恨，因为他们那么残忍地对待她。谁知道呢，或许她只是害怕被遗弃，就像她活着时那样。",
        "repeat": 200
      },
      {
        "name": "“疑”",
        "img": "/resource/35719843cc00a3600fa5d4c9b2eb6a82.png",
        "type": "时装",
        "description": "我认识过一个朋友，曾经是一个快乐的傻子，后来遭遇了变故，失去了最重要的东西，却得到了一种奇怪的能力——能闻出一切味道，除了一种，那种味道又咸又涩，你猜是什么?",
        "repeat": 200
      },
      {
        "name": "“夜魔”的仆从",
        "img": "/resource/2db8d10da1dbf48b0828e074f6faba8e.png",
        "type": "时装",
        "description": "我为什么会愿意跟随一个小姑娘?因为，我们第一次见面时，那位身陷囹圄的小姐告诉我，自由不是代价，只是筹码。",
        "repeat": 200
      },
      {
        "name": "“惊”",
        "img": "/resource/705b55746060fbb25d6f36d601b38165.png",
        "type": "时装",
        "description": "啊，到了我这个年纪，很多事情都忘了，不过我至今还记得那年在法国游历时看到的那位夫人，她穿着华美的裙子站在协和广场最高处，那裙子真美啊，摇曳的裙摆鲜艳得像血一样。",
        "repeat": 200
      },
      {
        "name": "“惧”",
        "img": "/resource/f80f2412f9f6a23988da6250b34b39ed.png",
        "type": "时装",
        "description": "那之后很久，我都会时常想起那夜的大火，慢慢地，我不再能分清，当时我听到的，是木梁燃烧的声响，还是被热浪扭曲的嚎哭。",
        "repeat": 200
      },
